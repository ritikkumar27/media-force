---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex min-h-screen items-center justify-center bg-base-200 p-4">
    <div class="card w-full max-w-md bg-base-100 shadow-xl border border-base-300">
      <div class="card-body">
        <h2 class="card-title justify-center text-3xl font-bold">Media Force</h2>
        <p class="text-center text-base-content/70 mb-4">Create a new account</p>
        
        <form id="register-form" class="space-y-4">
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Email</span></label>
            <input type="email" id="email" placeholder="user@example.com" class="input input-bordered w-full" required />
          </div>
          
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Password</span></label>
            <input type="password" id="password" class="input input-bordered w-full" required />
          </div>
          
          <p id="error-msg" class="text-error text-sm font-medium text-center hidden"></p>
          
          <button type="submit" id="submit-btn" class="btn btn-primary w-full mt-4">Sign Up</button>
        </form>

        <div class="divider">OR</div>
        <p class="text-center text-sm">
          Already have an account? <a href="/login" class="link link-primary">Log in here</a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
    // grabbing html elements by ids
    const form = document.getElementById('register-form');
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const errorMsg = document.getElementById('error-msg');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;


    // listening for form submission
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(errorMsg) errorMsg.classList.add('hidden');

        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating account...';

        try {
            // making api request to register endpoint
            const response = await fetch('http://localhost:3000/api/auth/register', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    email: emailInput.value,
                    password: passwordInput.value,
                })
            });

            const data = await response.json();


            if(!response.ok){
                throw new Error(data.message || 'Refistration failed');
            }

            const token = data.access_token || data.token;
            localStorage.setItem('mediaforce_token', token);

            window.location.href = '/dashboard';
        } catch (err: any){
            if(errorMsg){
                submitBtn.disabled = false;
                submitBtn.textContent = 'Sign Up';
            }
        }
    });
</script>