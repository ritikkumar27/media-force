---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex min-h-screen items-center justify-center bg-base-200 p-4">
    <div class="card w-full max-w-md bg-base-100 shadow-xl border border-base-300">
      <div class="card-body">
        <h2 class="card-title justify-center text-3xl font-bold">Media Force</h2>
        <p class="text-center text-base-content/70 mb-4">Sign in to access your downloads</p>
        
        <form id="login-form" class="space-y-4">
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Email</span></label>
            <input type="email" id="email" placeholder="user@example.com" class="input input-bordered w-full" required />
          </div>
          
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Password</span></label>
            <input type="password" id="password" class="input input-bordered w-full" required />
          </div>
          
          <p id="error-msg" class="text-error text-sm font-medium text-center hidden"></p>
          
          <button type="submit" id="submit-btn" class="btn btn-primary w-full mt-4">Sign In</button>
        </form>
        <div class="divider">OR</div>
        <p class="text-center text-sm">
          Don't have an account? <a href="/register" class="link link-primary">Sign up here</a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('login-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorMsg = document.getElementById('error-msg');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(errorMsg) errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    try {
      // NOTE: Update this URL to match your NestJS API
      const response = await fetch(`${API_URL}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value, password: passwordInput.value })
      });
      
      const data = await response.json();
      
      if (!response.ok) throw new Error(data.message || 'Invalid email or password');

      const token = data.access_token || data.token;
      
      // Save token natively in the browser instead of Zustand
      localStorage.setItem('mediaforce_token', token);
      
      // Redirect to dashboard
      window.location.href = '/dashboard';
    } catch (err: any) {
      if(errorMsg) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign In';
    }
  });
</script>