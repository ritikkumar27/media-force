---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="min-h-screen flex items-center justify-center bg-base-200">
    <div class="card w-96 bg-base-100 shadow-xl">
      <div class="card-body items-center text-center">
        <h2 class="card-title text-3xl font-bold text-primary">MediaForce</h2>
        <p>Your Astro + DaisyUI setup is working perfectly!</p>
        <div class="card-actions justify-end mt-4">
          <button class="btn btn-primary">Start Downloading</button>
        </div>
      </div>
    </div>
  </main>
</Layout>