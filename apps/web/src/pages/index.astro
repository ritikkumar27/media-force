---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <div class="hero min-h-screen bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-extrabold text-primary mb-8 tracking-tight">
          Test2: Unleash the Power of <br/> <span class="text-secondary">Media Force</span>
        </h1>
        <p class="py-6 text-xl text-base-content/80 mb-8">
          The ultimate self-hosted video downloader. Queue up links, process them in the background, and manage your entire media library from one blazing-fast dashboard.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/register" class="btn btn-primary btn-lg shadow-lg shadow-primary/30">
            Get Started for Free
          </a>
          <a href="/login" class="btn btn-outline btn-lg">
            I already have an account
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Feature Highlights -->
  <div class="bg-base-100 py-24">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      
      <div class="p-6 bg-base-200 rounded-2xl">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="text-xl font-bold mb-2">Lightning Fast</h3>
        <p class="text-base-content/70">Powered by Turborepo, Astro, and NestJS for maximum performance.</p>
      </div>

      <div class="p-6 bg-base-200 rounded-2xl">
        <div class="text-4xl mb-4">🔄</div>
        <h3 class="text-xl font-bold mb-2">Background Processing</h3>
        <p class="text-base-content/70">Close the tab. We process your downloads in the background using Redis queues.</p>
      </div>

      <div class="p-6 bg-base-200 rounded-2xl">
        <div class="text-4xl mb-4">🔒</div>
        <h3 class="text-xl font-bold mb-2">Private & Secure</h3>
        <p class="text-base-content/70">Self-hosted on your own homelab. You own your data and your bandwidth.</p>
      </div>

    </div>
  </div>
</Layout>

<script>
  // When the page loads, check if the user has an authentication token in their browser
  document.addEventListener("DOMContentLoaded", () => {
    const token = localStorage.getItem('mediaforce_token');
    
    // If they have a token, instantly redirect them to the dashboard
    if (token) {
      window.location.href = '/dashboard';
    }
  });
</script>