---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Premium Navbar -->
  <div class="navbar bg-base-100 shadow-sm sticky top-0 z-50 px-4 sm:px-8">
    <div class="flex-1">
      <a class="btn btn-ghost text-2xl font-black text-primary gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
          <path d="M7 11l5 5l5 -5"></path>
          <path d="M12 4l0 12"></path>
        </svg>
        MediaForce
      </a>
    </div>
    <div class="flex-none">
      <button id="logout-btn" class="btn btn-outline btn-error btn-sm rounded-full px-6">Logout</button>
    </div>
  </div>
  <main class="min-h-[calc(100vh-4rem)] bg-base-200 p-4 sm:p-8 flex flex-col items-center">
    
    <!-- Hero Header -->
    <div class="text-center mt-12 mb-8 max-w-2xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">What are we downloading today?</h1>
      <p class="text-lg text-base-content/70">Paste any supported video URL below and our workers will process it instantly.</p>
    </div>
    <!-- Main Workspace Area -->
    <div class="w-full max-w-3xl space-y-8 relative z-10">
      
      <!-- Input Card -->
      <div class="card bg-base-100 shadow-2xl border border-base-300/50 backdrop-blur-sm">
        <div class="card-body p-6 sm:p-10">
          <form id="download-form" class="flex flex-col sm:flex-row gap-4">
            <div class="relative flex-1">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-base-content/50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
              </div>
              <input type="url" id="yt-url" placeholder="https://youtube.com/watch?v=..." class="input input-bordered input-lg w-full pl-12 text-lg focus:input-primary transition-colors" required />
            </div>
            <button type="submit" id="start-btn" class="btn btn-primary btn-lg sm:w-48 shadow-lg shadow-primary/30 transition-transform active:scale-95">
              Start
            </button>
          </form>
          <p id="dashboard-error" class="text-error mt-4 font-medium text-center hidden"></p>
          <!-- Thumbnail Preview (Hidden initially) -->
          <div id="preview-section" class="mt-8 flex flex-col items-center hidden animate-fade-in">
            <div class="relative w-full max-w-md aspect-video rounded-2xl overflow-hidden bg-base-300 shadow-inner border border-base-content/10">
              <!-- Loading spinner -->
              <div id="preview-loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-base-200/80 backdrop-blur-sm z-10">
                <span class="loading loading-ring loading-lg text-primary"></span>
                <span class="text-sm font-medium text-base-content/70 animate-pulse">Fetching Metadata...</span>
              </div>
              <!-- Actual image -->
              <img id="preview-img" class="w-full h-full object-cover hidden transition-opacity duration-500" alt="Video Thumbnail" />
            </div>
            <h3 id="preview-title" class="mt-5 font-bold text-center text-xl line-clamp-2 px-4"></h3>
          </div>
        </div>
      </div>
      <!-- Real-Time Progress Widget (Hidden initially) -->
      <div id="progress-card" class="card bg-base-100 shadow-2xl border-t-4 border-t-primary hidden animate-slide-up">
        <div class="card-body p-6 sm:p-10 space-y-6">
          <div class="flex justify-between items-center border-b border-base-200 pb-4">
            <h2 class="card-title text-2xl text-primary gap-3">
              <span class="loading loading-infinity loading-md"></span>
              Processing Job
            </h2>
            <div class="badge badge-outline font-mono text-xs opacity-70">ID: <span id="job-id-text"></span></div>
          </div>
          
          <div class="space-y-2">
            <div class="flex justify-between text-sm font-bold tracking-wide uppercase text-base-content/70">
              <span>Download Progress</span>
              <span id="progress-text" class="text-primary">0.0%</span>
            </div>
            <!-- DaisyUI Progress Bar -->
            <progress id="progress-bar" class="progress progress-primary w-full h-4" value="0" max="100"></progress>
          </div>
          
          <div id="download-complete-section" class="flex flex-col items-center gap-4 pt-6 hidden animate-fade-in">
            <p class="text-success font-bold text-xl text-center">Ready for Download!</p>
            <a id="save-video-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg w-full sm:w-auto shadow-lg shadow-success/30 px-12">
              Save to Computer
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full max-w-5xl mt-16 space-y-6 z-10 relative">
      <div class="flex items-center justify-between border-b border-base-300 pb-2">
        <h2 class="text-2xl font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Recent Downloads
        </h2>
        <button id="refresh-history-btn" class="btn btn-ghost btn-sm btn-circle tooltip tooltip-left" data-tip="Refresh History">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>

        </button>

      </div>

      <!-- card injection -->
       <div id="downloads-history-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!--Place holder loading skeletons -->
        <div class="skeleton h-56 w-full rounded-2xl bg-base-300"></div>
        <div class="skeleton h-56 w-full rounded-2xl bg-base-300 hidden md:block"></div>
        <div class="skeleton h-56 w-full rounded-2xl bg-base-300 hidden lg:block"></div>


       </div>

      
    </div>
  </main>
</Layout>

<script>
  import { io } from "socket.io-client";

  // --- Auth Check ---
  const token = localStorage.getItem('mediaforce_token');
  if (!token) window.location.href = '/login';

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    localStorage.removeItem('mediaforce_token');
    window.location.href = '/login';
  });

  // --- Socket & Download Logic ---
  const socket = io("", {
    path: "/socket.io",
    auth: {
      token: token
    }
  });

  const form = document.getElementById('download-form');
  const urlInput = document.getElementById('yt-url') as HTMLInputElement;
  const startBtn = document.getElementById('start-btn') as HTMLButtonElement;
  const errorMsg = document.getElementById('dashboard-error');
  
  const progressCard = document.getElementById('progress-card');
  const jobIdText = document.getElementById('job-id-text');
  const progressText = document.getElementById('progress-text');
  const progressBar = document.getElementById('progress-bar') as HTMLProgressElement;
  const completeSection = document.getElementById('download-complete-section');
  const saveVideoBtn = document.getElementById('save-video-btn') as HTMLAnchorElement;
  const previewSection = document.getElementById('preview-section');
  const previewLoading = document.getElementById('preview-loading');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const previewTitle = document.getElementById('preview-title');



  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(errorMsg) errorMsg.classList.add('hidden');
    startBtn.disabled = true;
    startBtn.textContent = 'Starting...';

    try {
      // NOTE: Update URL to your NestJS API
      const response = await fetch('/api/downloads', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}` 
        },
        body: JSON.stringify({ url: urlInput.value })
      });
      
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Failed to start download');

      const jobId = data.id || data.jobId;
      
      // Show the progress card
      if(progressCard) progressCard.classList.remove('hidden');
      if(completeSection) completeSection.classList.add('hidden');
      if(jobIdText) jobIdText.textContent = jobId;
      progressBar.value = 0;
      if(progressText) progressText.textContent = '0.0%';

      // Listen for socket events specific to this Job ID
      socket.on(`download-progress-${jobId}`, (progressData: number | string) => {
        const val = typeof progressData === 'string' ? parseFloat(progressData) : progressData;
        progressBar.value = val;
        if(progressText) progressText.textContent = `${val.toFixed(1)}%`;

        if (val >= 100) {
          if(completeSection) completeSection.classList.remove('hidden');
          // Set the final download link
          saveVideoBtn.href = `/api/downloads/${jobId}/file?token=${token}`;
        }
      });

    } catch (err: any) {
      if(errorMsg) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
      }
    } finally {
      startBtn.disabled = false;
      startBtn.textContent = 'Start Download';
    }
  });


  urlInput?.addEventListener('input', async (e) => {
    const url = (e.target as HTMLInputElement).value;

    if (url.startsWith('http')) {
      if (previewSection) previewSection.classList.remove('hidden');
      if (previewLoading) previewLoading.classList.remove('hidden');
      if (previewImg) previewImg.classList.add('hidden');
      if (previewTitle) previewTitle.textContent = '';
      if (errorMsg) errorMsg.classList.add('hidden');

      try {
        const response = await fetch('api/downloads/metadata', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}` 
          },
          body: JSON.stringify({ url })
        });

        const data = await response.json();
        if (!response.ok) throw new Error();

        if (previewLoading) previewLoading.classList.add('hidden');

        if (previewImg) {
          previewImg.src = data.thumbnail;
          previewImg.classList.remove('hidden');
        }

        if (previewTitle) previewTitle.textContent = data.title;
      } catch (err) {
        if (previewSection) previewSection.classList.add('hidden');
      }
    } else {
      
      if (previewSection) previewSection.classList.add('hidden');
    }
    
  })

  //-- Downloads LOgic ---

  const historyGrid = document.getElementById('downloads-history-grid');
  const refreshBtn = document.getElementById('refresh-history-btn');

  async function loadDownloads() {
    if(!historyGrid) return;

    //showing loading skeleton while fetching
    historyGrid.innerHTML = `
      <div class="skeleton h-56 w-full rounded-2xl bg-base-300"></div>
      <div class="skeleton h-56 w-full rounded-2xl bg-base-300 hidden md:block"></div>
      <div class="skeleton h-56 w-full rounded-2xl bg-base-300 hidden lg:block"></div>
    `;

    try{
      const response = await fetch('/api/downloads', {
        headers: {'Authorization': `Bearer ${token}`}
      });

      if (!response.ok) throw new Error('Failed to fetch downloads');

      const downloads = await response.json();

      // if there are no downloadins, then mpty state

      if(downloads.length === 0){
        historyGrid.innerHTML = `
          <div class="col-span-full text-center py-12 text-base-content/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
            <p>No downloads yet. Start by pasting a URL above!</p>
          </div>
        `;
        return;
      }

      historyGrid.innerHTML = '';

      downloads.forEach((item: any) => {
        let statusBadge = '';
        if(item.status === "completed"){
          statusBadge = '<div class="badge badge-success gap-1 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Ready</div>';
        } else if (item.status === 'failed'){
          statusBadge = '<div class="badge badge-error gap-1 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg> Failed</div>';
        } else {
          statusBadge = '<div class="badge badge-warning gap-1 shadow-sm"><span class="loading loading-spinner loading-xs"></span> Processing</div>';
        }

        // Action Button

        const actionButton = item.status === 'completed'
          ? `<a href="/api/downloads/${item.id}/file?token=${token}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm w-full shadow-md">Download Again</a>`
          : `<button class="btn btn-outline btn-sm w-full" disabled>Autocleaned</button>`;

          const cardHTML = `
            <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden hover:shadow-2xl transition-all hover:-translate-y-1">
              <figure class="aspect-video relative bg-base-300">
                <img src="${item.thumbnail || 'https://via.placeholder.com/640x360?text=No+Thumbnail'}" alt="Thumbnail" class="w-full h-full object-cover" />
                <div class="absolute top-2 right-2">
                  ${statusBadge}
                </div>
              </figure>
              <div class="card-body p-5">
                <h3 class="card-title text-base line-clamp-2 leading-tight" title="${item.title || item.url}">
                  ${item.title || 'Processing Metadata...'}
                </h3>
                <p class="text-xs text-base-content/60 truncate mt-1">${new Date(item.createdAt).toLocaleDateString()} • ${new Date(item.createdAt).toLocaleTimeString()}</p>
                <div class="card-actions justify-end mt-4">
                  ${actionButton}
                </div>
              </div>
            </div>
          `;

          historyGrid.innerHTML += cardHTML;
      });
    }catch (err) {
      console.error(err);
      historyGrid.innerHTML = `
        <div class="col-span-full text-center py-8 text-error">
          <p>Failed to load downloads. Please check your connection.</p>
        </div>
      `;
    }
  }

  // binding refresh btn

  refreshBtn?.addEventListener('click', () => {
    refreshBtn.classList.add('animate-[spin_0.5s_linear_1]');
    setTimeout(() => refreshBtn.classList.remove('animate-[spin_0.5s_linear_1]'), 500);
    loadDownloads();
  });

  loadDownloads();

</script>